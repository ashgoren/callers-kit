{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // DOM: e2e/**/*.ts (also covered by this config) runs Node code that
    // calls Playwright's page/locator.evaluate(), whose callback body
    // actually executes in a real browser - it needs DOM types (Element,
    // HTMLElement, etc.) to type-check that callback's parameter, even
    // though vite.config.ts/playwright.config.ts themselves never
    // reference any DOM global.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
